# Copy to .env.local for local development (never commit real secrets).

# --- Storage -----------------------------------------------------------------
# Leave both blank locally: the app then uses a SQLite file at .data/dev.sqlite.
# In production (Vercel) both are REQUIRED. Find them in the Supabase dashboard:
# Project Settings -> API. The service-role key is a SECRET: server-side only,
# never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
# Direct Postgres connection string (Supabase: Connect -> Session pooler). Only the local scripts
# `npm run db:schema` and `npm run db:reset` use it; it is NOT needed on Vercel.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin area (/admin) --------------------------------------------------------
# Password for the admin page, and a long random string used to sign the admin
# session cookie (generate with: openssl rand -hex 32).
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
